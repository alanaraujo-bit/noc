<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Noc</AssemblyName>
    <RootNamespace>Noc.Companion</RootNamespace>
    <ApplicationIcon>Assets\noc.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Noc Companion</Product>
    <Company>Noc</Company>
    <Description>Noc Companion — acesso seguro às suas IAs locais pelo celular</Description>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- arquivo único: as DLLs nativas do WPF vão dentro do Noc.exe (o instalador só copia o exe e runtimes\) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Assets\noc.ico" />
    <Resource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Noc.Core\Noc.Core.csproj" />
  </ItemGroup>

  <!-- Whisper: as DLLs nativas precisam ficar ao lado do exe (runtimes/<lib>/win-x64), fora do arquivo único;
       as de outros sistemas não vão no pacote. -->
  <Target Name="NocWhisperNatives" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_ComputeFilesToBundle;GenerateSingleFileBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes')) and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('win-x64'))" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes'))" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
